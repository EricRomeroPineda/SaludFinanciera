# El backend corre en Windows junto a MySQL; localhost apunta a esa PC.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=salud_financiera
DB_USER=root
DB_PASSWORD=

SESSION_SECRET=
API_PORT=3001
API_HOST=127.0.0.1

# Opcional: ID publico OAuth de tipo Aplicacion web (no es el client secret).
GOOGLE_CALENDAR_CLIENT_ID=

# Configuracion prevista para verificacion de correo y cambio de palabra clave.
# Estas variables aun no estan conectadas al backend; no activan el envio por si solas.
# URL publica del tunel de Cloudflare para abrir los enlaces desde otros dispositivos.
APP_BASE_URL=https://lifekit.work

# Gmail SMTP: activa la verificacion en dos pasos y genera una contrasena de aplicacion.
# No uses la contrasena normal de tu cuenta ni subas credenciales reales a GitHub.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Direccion remitente; usa la misma cuenta Gmail configurada en SMTP_USER.
SMTP_FROM=
